# Editor settings shared by IntelliJ, VS Code and most editors (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,html,js,css,json,geojson}]
indent_size = 2

# start.spring.io generated pom.xml with tabs; keep it that way.
[pom.xml]
indent_style = tab

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Windows batch files need CRLF (see .gitattributes).
[*.cmd]
end_of_line = crlf
