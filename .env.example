# No quotes — this file is read as .properties, so quote marks become part of the value.
# Copy it to .env in the project root (.env is gitignored; never commit it).

# Modes: stub or live. Keep a value here (an empty value also means stub).
# Google: stub = made-up straight-line routes and "(stub)" facilities, no Google calls;
#         live = real Google calls, needs GOOGLE_MAPS_SERVER_KEY (the app refuses to start without it)
GOOGLE_MODE=stub
# OneMap: stub = a few recorded real OneMap answers; live = real OneMap address search (free, no key)
ONEMAP_MODE=stub

# Keys: leave them empty unless you hold them (key owner E, backup A).
# Routes + Places, server side only
GOOGLE_MAPS_SERVER_KEY=
# Maps JavaScript API in the browser (restricted to http://localhost:8080/*); works in stub mode too
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Optional; the public data.gov.sg API works without it (importer only)
DATAGOVSG_API_KEY=

# Database: only for the postgres and prod profiles. dev and demo use an H2 file and need none of these.
# postgres profile (and compose.yaml): the defaults below are used when a line stays commented out.
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=schoolmatch
#DB_USERNAME=schoolmatch
#DB_PASSWORD=schoolmatch
# prod profile: the whole JDBC URL (plus DB_USERNAME and DB_PASSWORD, which then have no default). The driver
# checks the server certificate (sslmode=verify-full); sslrootcert names the provider's CA bundle.
#DB_URL=jdbc:postgresql://db.example.com:5432/schoolmatch?sslmode=verify-full&sslrootcert=/path/to/ca-bundle.pem&reWriteBatchedInserts=true
# prod profile: true only for the one deploy that rolls the school data back (data/README.md, "Rollback")
#DATASET_ALLOW_ROLLBACK=false
