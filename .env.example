# No quotes — this file is read as .properties, so quote marks become part of the value.
# Copy it to .env in the project root (.env is gitignored; never commit it).

# Modes: stub or live. Keep a value here (an empty value also means stub).
# Google: stub = made-up straight-line routes and "(stub)" facilities, no Google calls;
#         live = real Google calls, needs GOOGLE_MAPS_SERVER_KEY (the app refuses to start without it)
GOOGLE_MODE=stub
# OneMap: stub = a few recorded real OneMap answers; live = real OneMap address search (free, no key)
ONEMAP_MODE=stub

# Keys: leave them empty unless you hold them (key owner E, backup A).
# Routes + Places, server side only
GOOGLE_MAPS_SERVER_KEY=
# Maps JavaScript API in the browser (restricted to http://localhost:8080/*); works in stub mode too
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Optional; the public data.gov.sg API works without it (importer only)
DATAGOVSG_API_KEY=
