# The HTTPS proxy of the production site (docs/deployment.md). Caddy gets and renews the certificate for the site
# address by itself through ports 80 and 443, and sends http:// visitors to https://.
{
	# With an email, Caddy also tries ZeroSSL when Let's Encrypt refuses. This is the contact address of the Terms and
	# privacy page; both certificate services receive it.
	email dommyshappynow@gmail.com
	log default {
		exclude admin.api # the health check every 15 s would fill the log
	}
	servers {
		protocols h1 h2 # HTTP/3 needs UDP port 443, and the server's firewall opens TCP only
	}
}

{$SITE_ADDRESS} {
	# Never add a Referrer-Policy that strips the referrer: the Google browser key only works on pages whose
	# referrer matches its website restriction.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=86400"
	}

	# ===== PASSWORD ON THE WHOLE SITE: OFF. Put it on before real parents may look for such a site. =====
	# docs/deployment.md, "Putting a password on the site": set SITE_USERNAME and SITE_PASSWORD_HASH in the server's
	# .env, remove the "# " from the four lines below, commit, and run deploy.sh. The health check stays open.
	# @locked not path /actuator/health/readiness
	# basic_auth @locked {
	# 	{$SITE_USERNAME} {$SITE_PASSWORD_HASH}
	# }
	# ===== END OF THE PASSWORD BLOCK =====

	reverse_proxy app:8080 {
		transport http {
			keepalive 60s # shorter than the app's 75 s, so Caddy never reuses a connection the app has just closed
		}
	}
}
